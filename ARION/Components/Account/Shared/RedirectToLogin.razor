@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        // Avoid redirect loop: only navigate when we're not already on the login page
        try
        {
            var currentPath = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');
            if (!string.Equals(currentPath, "/Account/Login", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo($"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", forceLoad: true);
            }
        }
        catch
        {
            // If Uri parsing fails for any reason, fall back to navigating to login
            NavigationManager.NavigateTo($"Account/Login?returnurl={Uri.EscapeDataString(NavigationManager.Uri)}", forceLoad: true);
        }
    }
}
